    <main>
            <div class="container-fluid">
                <form class="d-flex" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
                </form>
            </div>

            <section>
            @{

                    for(int i = 0; i < ViewBag.Playlists.Count; i++)
                { 
                <div>
                    <img src= "/Imagenes/@ViewBag.Playlists[i].foto" alt="FotoPlaylist">
                    <h2> @ViewBag.Playlists[i].titulo </h2>
                    <a href='@Url.Action("Playlist_Frecuencias", "Home", new {id = @ViewBag.Playlists.id})'>Play</a>
                    @foreach(Tag item in ViewBag.listaTags[i])    
                    {
                       <p>@item.titulo</p> 
                    }
                </div>
                }

            }

            </section>
    </main>