
<main class="playlist-frecuencias-page">
    <div class="playlist-header">
        <img src="/Imagenes/fondoPlaylist.png" alt="@ViewBag.playlist.titulo" class="playlist-main-img">
        <h1 class="playlist-main-titulo">@ViewBag.playlist.titulo</h1>
        <h5 class="playlist-main-autor">NoHaze Team</h5>

        <div class="playlist-controles">
            <button onclick="Play()" class="playlist-btn-control">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                Play
            </button>
            <button onclick="Shuffle()" class="playlist-btn-control">
                <svg viewBox="0 0 24 24"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
                Shuffle
            </button>
        </div>
    </div>

    <section class="frecuencias-lista">
        <div class="frecuencia-item">
            <div class="frecuencia-icon">
                <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
            </div>
            <div class="frecuencia-content">
                <h2 class="frecuencia-titulo">1000hz (Dormir)</h2>
                <h5 class="frecuencia-autor">NoHaze Team</h5>
            </div>
            <button onclick="Play()" class="frecuencia-btn-play">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </button>
        </div>
        
        <!-- Repetir para cada frecuencia -->
    </section>

    <!-- Botón volver (flecha) -->
    <div class="centrar">
        <a href='@Url.Action("Playlist","Home")' class="back-arrow">&#8629;</a>
    </div>

</main>


